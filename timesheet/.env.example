# Porta do servidor HTTP
PORT=3000

# Caminho do banco SQLite (default: ./data/timesheet.db)
TIMESHEET_DB=./data/timesheet.db

# Segredo usado para assinar/derivar tokens de sessão.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se ausente, um segredo é gerado e persistido no banco na primeira execução.
SESSION_SECRET=

# Conta master criada no primeiro boot (bootstrap). Se a senha ficar vazia,
# uma senha aleatória é gerada e impressa UMA ÚNICA VEZ no log de inicialização.
BOOTSTRAP_MASTER_NAME=Administrador
BOOTSTRAP_MASTER_EMAIL=admin@azeredoeugatti.com.br
BOOTSTRAP_MASTER_PASSWORD=

# Defina como "true" apenas atrás de um proxy HTTPS (marca o cookie como Secure)
SECURE_COOKIES=false
