# Domínio já apontando para o IP deste servidor (registro A no DNS).
DOMAIN=timesheet.azeredoeugatti.com.br

# --- Só para o modo "subpágina do site" (azeredoeugatti.com.br/timesheet) ---
# Deixe ambos VAZIOS para o modo normal, em que o sistema ocupa o subdomínio
# inteiro. Preenchidos, o sistema passa a responder apenas sob o caminho
# indicado, e aceita requisições vindas do endereço público informado.
# Veja deploy/cloudflare-worker.js e docs/IMPLANTACAO.md.
BASE_PATH=
PUBLIC_ORIGIN=

# Segredo das sessões. Gere uma vez e não troque depois — trocar derruba todas
# as sessões abertas. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Conta master criada no primeiro boot. Deixe a senha vazia para que o sistema
# gere uma e a imprima no log (docker compose logs app).
BOOTSTRAP_MASTER_NAME=Leonardo Ugatti
BOOTSTRAP_MASTER_EMAIL=leonardo@azeredoeugatti.com.br
BOOTSTRAP_MASTER_PASSWORD=

FIRM_NAME=Azeredo & Ugatti Advogados

# Horas até a sessão expirar (12 = precisa entrar de novo uma vez por dia).
SESSION_TTL_HOURS=12
