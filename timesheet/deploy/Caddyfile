# O Caddy obtém e renova o certificado TLS sozinho (Let's Encrypt), desde que o
# domínio aponte para o IP deste servidor e as portas 80 e 443 estejam abertas.
{$DOMAIN} {
	encode zstd gzip

	# Cabeçalhos de segurança aplicados a todas as respostas.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy app:3000

	log {
		output file /data/acesso.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
