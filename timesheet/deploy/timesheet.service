# Alternativa sem Docker: roda o sistema direto no servidor, sob systemd.
# Instalar com:
#   sudo cp deploy/timesheet.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now timesheet
[Unit]
Description=Timesheet — Azeredo & Ugatti Advogados
After=network.target

[Service]
Type=simple
User=timesheet
WorkingDirectory=/opt/timesheet
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=TIMESHEET_DB=/opt/timesheet/data/timesheet.db
Environment=SECURE_COOKIES=true
Environment=TZ=America/Sao_Paulo
EnvironmentFile=/opt/timesheet/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5

# Restrições de segurança: o processo só escreve onde precisa.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/timesheet/data /opt/timesheet/backups

[Install]
WantedBy=multi-user.target
